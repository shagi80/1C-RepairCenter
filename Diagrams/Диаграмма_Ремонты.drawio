              <mxPoint x="-763" y="1080" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="FoNBsvAcSC1_sTMHuzR6-101" edge="1" parent="1" source="FoNBsvAcSC1_sTMHuzR6-40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="FoNBsvAcSC1_sTMHuzR6-69">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-1570" y="1058" />
              <mxPoint x="-1570" y="1280" />
              <mxPoint x="-1289" y="1280" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="FoNBsvAcSC1_sTMHuzR6-106" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Поле &quot;код&quot; в документах и справочниках&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;В базах данных сайта каждая запись любой таблицы имеет поле id - уникальный идентификатор записи. Это поле мы должны использовать для связи данных между сайтом и 1С.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="93" width="680" x="-2280" y="1221" as="geometry" />
        </mxCell>
        <mxCell id="FoNBsvAcSC1_sTMHuzR6-107" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Данные о производителе&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Поля &quot;Производитель&quot;, &quot;ПроизвдственнаяСмена&quot; и &quot;Дата производства&quot; в записе о ремонте не заполняются в ручную. Они определяются для заводской продукции, имеющей информативный серийный номер, путем анализа этого номера. Сайт уже выполняет эту операцию. Можно просто переписать эти поля с сайта, а можно и отказаться от них. Данные в регистре будет заполнять при проведении анализируя серийный номер &quot;на лету&quot;.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="680" x="-2280" y="1347" as="geometry" />
        </mxCell>
        <mxCell id="FoNBsvAcSC1_sTMHuzR6-108" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" value="Справочник ГруппыМоделей&#xa;подчинение: Справочник.ВидыПродукции " vertex="1">
